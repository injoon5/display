# Root env for local Convex (cloud agents / `npm run stack`)
#
# CONVEX_AGENT_MODE=anonymous lets cloud/local agents use an isolated
# anonymous Convex deployment instead of your personal one.
CONVEX_AGENT_MODE=anonymous
#
# CONVEX_URL is the client/API WebSocket URL used by the dashboard + fetcher.
CONVEX_URL=http://127.0.0.1:3210
#
# CONVEX_SITE_URL is the HTTP actions URL used by device/emulator routes
# (/device/wait, /device/sync, /device/data, /api/pin, …).
CONVEX_SITE_URL=http://127.0.0.1:3211
#
# Optional: override dashboard HTTP shared secret (defaults to dashboard-secret).
# DASHBOARD_SECRET=dashboard-secret
