<card id="air" name="Air Quality" priority="72">
  <source id="air" kind="airkorea" station="Gangnam-gu" every="10m" />
  <text x="1" y="3" font="3x5" color="#8f9f8d">PM2.5</text>
  <text x="1" y="11" font="5x7" color="#e0e0e0">{{ air.pm25 }}</text>
  <text x="24" y="11" font="3x5" color="#8f9f8d">ug</text>
  <text x="1" y="23" font="3x5" color="{{ air.grade == 'good' ? '#52d6a7' : '#ffb020' }}">{{ air.grade | upper | trunc(15) }}</text>
  <stale after="20m" style="dim" />
</card>
