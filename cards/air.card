<card id="air" name="Air Quality" priority="72">
  <source id="air" kind="airkorea" station="Gangnam-gu" every="10m" />
  <text x="2" y="0" font="5x7" color="#8f9f8d">PM2.5</text>
  <text x="2" y="9" font="8x16" color="#f0f0f0">{{ air.pm25 }}</text>
  <text x="40" y="13" font="5x7" color="#8f9f8d">ug</text>
  <text x="2" y="25" font="5x7" color="{{ air.grade == 'good' ? '#52d6a7' : '#ffb020' }}">{{ air.grade | upper | trunc(10) }}</text>
  <stale after="20m" style="dim" />
</card>
