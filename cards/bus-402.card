<card id="bus-402" name="Bus 402" priority="90">
  <source id="bus" kind="seoul.bus" arsId="23-005" route="402" every="20s" />
  <text x="2" y="2" font="5x7" color="#f0a030">402</text>
  <text x="28" y="2" font="5x7" color="#f0f0f0">{{ bus.eta_min }}</text>
  <text x="44" y="2" font="5x7" color="#8f9f8d">min</text>
  <text x="2" y="13" font="5x7" color="#52d6a7">146</text>
  <text x="28" y="13" font="5x7" color="#f0f0f0">{{ bus.next_eta_min | default('--') }}</text>
  <text x="44" y="13" font="5x7" color="#8f9f8d">min</text>
  <text x="2" y="24" font="5x7" color="#6fb1ff">341</text>
  <text x="28" y="24" font="5x7" color="#f0f0f0">{{ bus.third_eta_min | default('--') }}</text>
  <text x="44" y="24" font="5x7" color="#8f9f8d">min</text>
  <stale after="90s" style="dim" />
</card>
