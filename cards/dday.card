<card id="dday" name="D-Day" priority="53">
  <text x="2" y="1" font="5x7" color="#ff6b5c">{{ dday.label }}</text>
  <text x="2" y="13" font="5x7" color="#f0f0f0">D-</text>
  <text x="15" y="9" font="8x16" color="#f0f0f0">{{ dday.days }}</text>
  <text x="2" y="25" font="5x7" color="#8f9f8d">DAYS LEFT</text>
</card>
