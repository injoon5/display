<card id="self-status" name="Self Status" priority="58">
  <source id="telemetry" kind="panel.telemetry" every="60s" />
  <source id="device" kind="panel.device" every="60s" />
  <text x="2" y="0" font="5x7" color="#8f9f8d">RSSI</text>
  <text x="27" y="0" font="5x7" color="#f0f0f0">{{ telemetry.rssi }}</text>
  <text x="2" y="8" font="5x7" color="#8f9f8d">UP</text>
  <text x="20" y="8" font="5x7" color="#f0f0f0">{{ telemetry.uptime_s | default(0) | duration }}</text>
  <text x="2" y="16" font="5x7" color="#8f9f8d">PRG</text>
  <text x="26" y="16" font="5x7" color="#f0f0f0">{{ device.programVersion }}</text>
  <text x="2" y="24" font="5x7" color="#8f9f8d">FW</text>
  <text x="20" y="24" font="5x7" color="#f0f0f0">{{ device.fwVersion | trunc(6) }}</text>
  <stale after="3m" style="dim" />
</card>
