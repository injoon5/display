<card id="weather" name="Weather" priority="76">
  <source id="wx" kind="kma.now" station="Seoul-108" every="10m" />
  <text x="2" y="0" font="5x7" color="#6fb1ff">NOW</text>
  <text x="2" y="9" font="8x16" color="#f0f0f0">{{ wx.tempC | round }}</text>
  <text x="28" y="13" font="5x7" color="#8f9f8d">C</text>
  <text x="2" y="25" font="5x7" color="#8f9f8d">{{ wx.condition | upper | trunc(10) }}</text>
  <stale after="20m" style="dim" />
</card>
