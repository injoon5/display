<card id="weather" name="Weather" priority="76">
  <source id="wx" kind="kma.now" station="Seoul-108" every="10m" />
  <text x="1" y="3" font="3x5" color="#6fb1ff">NOW</text>
  <text x="1" y="11" font="5x7" color="#e0e0e0">{{ wx.tempC | round }}</text>
  <text x="24" y="11" font="3x5" color="#8f9f8d">C</text>
  <text x="1" y="23" font="3x5" color="#8f9f8d">{{ wx.condition | upper | trunc(15) }}</text>
  <stale after="20m" style="dim" />
</card>
