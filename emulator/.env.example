# Device/emulator talks to Convex HTTP actions (site URL), not the client API URL.
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
# Aliases also accepted by the emulator config loader:
# MX_SITE_URL=http://127.0.0.1:3211
# MX_DEVICE_TOKEN=dev-token-matrix-panel-demo
# Must match the seeded demo device token from convex/lib/seed.ts
DEVICE_TOKEN=dev-token-matrix-panel-demo
EMULATOR_PORT=8787
