# Required
CONVEX_URL=https://your-deployment.convex.cloud

# Optional but recommended for locked-down deployments.
# If omitted, the fetcher will call the current public mutations directly.
CONVEX_SERVICE_TOKEN=
CONVEX_DEPLOY_KEY=

# Optional runtime tuning
FETCH_TIMEOUT_MS=8000

# Optional for the docker-compose tailscale profile
TS_AUTHKEY=

# Real Korean API keys are intentionally not required here.
# The fetcher ships dummy Seoul-shaped data only.
DATA_GO_KR_KEY=
KMA_KEY=
AIRKOREA_KEY=
